# Local model path. Update this to your local OpticsGPT-v0 directory.
MODEL_DIR=C:\path\to\OpticsGPT-v0
MODEL_NAME=OpticsGPT-v0

# Lens database. The full dataset is private and not included in the public repo.
LENS_DATA_PATH=.\data\lens_data.csv

# Ray tracing controls.
REALTIME_RAYTRACE=1
RAYTRACE_USE_CACHE=1
RAYTRACE_NUM_RAYS=32

# Optional project paths.
PROJECT_ROOT=.
DAT_DIR=.\data\dat
CODEV_BLOCK_DIR=.\data\codev_blocks
RAYTRACE_CACHE_PATH=.\data\raytrace_cache\realtime_raytrace_cache.json
